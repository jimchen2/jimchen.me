# Postgres connection string (Neon in production).
# Leave it empty to run on the markdown posts in content/posts/ instead.
POSTGRESQL_URL=

# Public origin, used for canonical URLs, the RSS feed and the sitemap.
# When unset the origin is derived from the incoming request.
NEXT_PUBLIC_SITE=http://localhost:3000

# Secret used to sign the like/view tokens (any long random string).
likes_SECRET_KEY=
