# Postgres connection string (Neon in production).
#
# Leave this EMPTY to run the site from the Markdown files in content/blogs.
# Likes, views and comments then live in memory and reset on restart.
POSTGRESQL_URL=

# Canonical origin, used for canonical URLs, Open Graph tags and the RSS feed.
# Falls back to the request host when unset, so local dev works without it.
NEXT_PUBLIC_SITE=http://localhost:3000

# HMAC secret that signs like/view tokens. Required in production;
# a random per-process value is generated when unset.
likes_SECRET_KEY=
